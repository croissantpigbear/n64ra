+/// Watch exception (exception code 23): a store to the doubleword set in
+/// WatchLo, with its W bit on. Cheat engines (GameShark, N64FlashcartMenu)
+/// use it to catch a game installing its exception handler.
+pub fn watch_exception(device: &mut device::Device) {
+    set_exception_cause(device, 23 << 2);
+    exception_general(device, 0x180)
+}
