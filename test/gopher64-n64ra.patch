+/// Stores to the WatchLo doubleword raise a watch exception (not while
+/// EXL or ERL is set), before the store happens.
+fn watch_hit(device: &mut device::Device, phys_address: u64, access_type: &AccessType) -> bool {
+    let watch_lo = device.cpu.cop0.regs[18];
+    if !matches!(access_type, AccessType::Write)
+        || watch_lo & 1 == 0
+        || device.cpu.cop0.regs[device::cop0::COP0_STATUS_REG]
+            & (device::cop0::COP0_STATUS_EXL | device::cop0::COP0_STATUS_ERL)
+            != 0
+        || (phys_address & 0x1FFFFFF8) != (watch_lo & 0x1FFFFFF8)
+    {
+        return false;
+    }
+    device::exceptions::watch_exception(device);
+    true
+}
